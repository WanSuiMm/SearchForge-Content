    },
    {
      "path": "scripts/verify.py",
      "old": "WORKSPACE / \"project_SearchForge/src/searchforge/community\"",
      "new": "ROOT / \"components/searchforge/src/searchforge/community\""
    },
    {
      "path": "scripts/verify.py",
      "old": "path.relative_to(WORKSPACE).as_posix()",
      "new": "path.relative_to(ROOT).as_posix()"
    },
    {
      "path": "scripts/verify.py",
      "old": "WORKSPACE / \"project_ContentPlatform/src/content_platform\" / relative",
      "new": "ROOT / \"components/content-platform/src/content_platform\" / relative"
    },
