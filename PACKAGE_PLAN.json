  },
  "attribution_map": [
    {
      "origin": "project_SearchForgeContent/src, scripts/content.py, scripts/verify.py, tests/test_integration.py, contracts/content-event-v1.schema.json",
      "destination": "SearchForge Content-owned root paths",
      "change": "Only the two explicit sibling import roots, verifier test/hash roots, and integration test import roots are rewritten. Preserve behavior and source history in the attributed mapping."
    },
    {
      "origin": "project_SearchForge/src/searchforge/community",
      "destination": "components/searchforge/src/searchforge/community",
      "change": "Keep the component name and package path; do not copy the rest of SearchForge or its model/commerce modules."
    },
    {
      "origin": "project_ReportForge/reportforge/__init__.py, corpus.py, models.py, retrieval.py",
      "destination": "src/searchforge_content/retrieval/reportforge/",
      "change": "Keep existing method code and relative imports unchanged. This source supplies BM25, FAISS/SentenceTransformers dense retrieval, RRF, and optional CrossEncoder reranking. It is a general library, not the R02 runner. Upstream project metadata declares MIT; no standalone license text was found in that source root."
    },
    {
      "origin": "project_SearchForgeContent/benchmarks/aligned_full_freshstack_20261031_r02/ce_windowing.py",
      "destination": "src/searchforge_content/retrieval/r02/ce_windowing.py",
      "change": "Keep the pure overflow-safe ranking helper; do not copy the bound runner, corpus, model cache, run manifests, query/qrels files, or deployment configuration. This helper is not wired into the ReportForge Retriever."
    },
    {
      "origin": "project_ContentPlatform/src/content_platform, scripts/server.py, pyproject.toml, backend-java and selected tests/web sources",
      "destination": "components/content-platform/",
      "change": "Preserve source ownership in the path. Do not merge its database with the SearchForge index. Exclude workspace-only project docs and the built React bundle."
    }
  ],
  "external_http_contracts": [
    {
      "name": "ContentPlatform projection source",
      "contract": "contracts/content-event-v1.schema.json and the internal events/ack/content/resolve routes documented in ARCHITECTURE.md",
      "configuration": "operator supplies --source-url and a dedicated token through a named environment variable",
      "constraint": "No direct database access; non-loopback origins require HTTPS; no endpoint host is embedded in the package."
    },
    {
      "name": "Other C1/C2 services",
      "contract": "No current C3 runtime client is present; any future integration must be declared as a versioned HTTP contract with explicit auth and failure semantics.",
      "constraint": "Do not copy sibling services or add cross-project Python imports/shared database access."
    }
  ],
  "rights_and_redistribution": [
    "No unified package-wide relicensing term has been selected. The SearchForge Content, SearchForge and ContentPlatform roots have no LICENSE/COPYING/NOTICE file; ReportForge's pyproject metadata declares MIT, though no standalone license text was present in the inspected source root. Preserve component attribution and do not imply the ReportForge term covers every component.",
    "Keep the npm and Maven dependency manifests, but do not vendor node_modules, generated React app.js, dist output, target output, or dependency caches. If a compiled frontend bundle or jar is later distributed, include the applicable third-party notices.",
    "Do not include corpora, source snapshots, queries, qrels, source aliases, indexes, embeddings, SQLite databases or per-query results. FreshStack data is marked CC BY-SA 4.0 in its dataset card, while its underlying repositories may have different terms; each other corpus source also retains its own terms."
  ],
  "materialization_checks": [
    "Before publication, re-check the exact staged file list, file sizes, generated files, tokens, local paths and host identifiers.",
    "After the source copies and path rewrites are complete, verify the event contract link and all Markdown links from this package root.",
    "The documented fresh-database functional check is available to reviewers; this packaging pass did not execute code, tests, services, models or experiments.",
