      "path": "src/README.md",
      "old": "../docs/ARCHITECTURE.md",
      "new": "../ARCHITECTURE.md"
    },
    {
      "path": "scripts/content.py",
      "old": "sys.path[:0] = [str(ROOT / \"src\"), str(ROOT.parent / \"project_SearchForge\" / \"src\")]",
      "new": "sys.path[:0] = [str(ROOT / \"src\"), str(ROOT / \"components\" / \"searchforge\" / \"src\")]"
    },
    {
      "path": "scripts/verify.py",
      "old": "WORKSPACE = ROOT.parent\nsys.path[:0] = [str(ROOT / \"src\"), str(WORKSPACE / \"project_SearchForge/src\"),\n               str(WORKSPACE / \"project_ContentPlatform/src\")]",
      "new": "sys.path[:0] = [str(ROOT / \"src\"), str(ROOT / \"components/searchforge/src\"),\n               str(ROOT / \"components/content-platform/src\")]"
    },
